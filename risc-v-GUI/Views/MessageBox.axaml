<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:risc_v_GUI.ViewModels"
        xmlns:local="clr-namespace:risc_v_GUI.Models"
        x:Class="risc_v_GUI.Views.MessageBox"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Error"
        Width="380" Height="160"
        Background="#181825">
    
        <DockPanel Margin="20">

                <Button DockPanel.Dock="Bottom"
                        Content="OK"
                        HorizontalAlignment="Right"
                        Background="#313244"
                        Foreground="#cdd6f4"
                        BorderThickness="0"
                        CornerRadius="5"
                        Padding="24,6"
                        Click="OnOkClick"/>

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Spacing="10">
                        <TextBlock Text="✕"
                                   Foreground="#f38ba8"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="MessageText"
                                   Foreground="#cdd6f4"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"/>
                </StackPanel>

        </DockPanel>
</Window>