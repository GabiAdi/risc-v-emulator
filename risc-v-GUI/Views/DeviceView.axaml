<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:risc_v_GUI.ViewModels"
        xmlns:local="clr-namespace:risc_v_GUI"
        x:Class="risc_v_GUI.DeviceView"
        x:DataType="vm:MainWindowViewModel"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        Title="Device manager"
        Width="800" Height="450"
        Background="#eff1f5">

  <Grid ColumnDefinitions="180,*">

    <!-- ══ LEFT PANEL ══════════════════════════════════════════════════ -->
    <Border Grid.Column="0" Background="#dce0e8" Padding="12">
      <DockPanel LastChildFill="False">

        <!-- Save button pinned to bottom -->
        <Button DockPanel.Dock="Bottom"
                Content="💾  Save"
                Background="#8839ef"
                Foreground="#eff1f5"
                FontWeight="SemiBold"
                CornerRadius="6"
                Padding="10,9"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                Margin="0,8,0,0"
                Click="OnSaveClick"/>

        <!-- Device list -->
        <StackPanel Spacing="6">
          <TextBlock Text="DEVICES" Foreground="#9ca0b0"
                     FontSize="11" FontWeight="Bold"
                     LetterSpacing="2" Margin="0,0,0,10"/>

          <!-- ROM -->
          <Border Tag="ROM" CornerRadius="6" Padding="10,9" Cursor="Hand"
                  Background="#fbe8ea" BorderBrush="#d20f39" BorderThickness="1"
                  PointerPressed="OnSourceItemPressed">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Ellipse Width="8" Height="8" Fill="#d20f39" VerticalAlignment="Center"/>
              <TextBlock Text="ROM" Foreground="#4c4f69" FontWeight="SemiBold"/>
            </StackPanel>
          </Border>

          <!-- RAM -->
          <Border Tag="RAM" CornerRadius="6" Padding="10,9" Cursor="Hand"
                  Background="#e4f2e0" BorderBrush="#40a02b" BorderThickness="1"
                  PointerPressed="OnSourceItemPressed">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Ellipse Width="8" Height="8" Fill="#40a02b" VerticalAlignment="Center"/>
              <TextBlock Text="RAM" Foreground="#4c4f69" FontWeight="SemiBold"/>
            </StackPanel>
          </Border>

          <!-- Disk -->
          <Border Tag="Disk" CornerRadius="6" Padding="10,9" Cursor="Hand"
                  Background="#fde8d4" BorderBrush="#fe640b" BorderThickness="1"
                  PointerPressed="OnSourceItemPressed">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Ellipse Width="8" Height="8" Fill="#fe640b" VerticalAlignment="Center"/>
              <TextBlock Text="Disk" Foreground="#4c4f69" FontWeight="SemiBold"/>
            </StackPanel>
          </Border>

          <!-- GPU -->
          <Border Tag="GPU" CornerRadius="6" Padding="10,9" Cursor="Hand"
                  Background="#ede0f8" BorderBrush="#8839ef" BorderThickness="1"
                  PointerPressed="OnSourceItemPressed">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Ellipse Width="8" Height="8" Fill="#8839ef" VerticalAlignment="Center"/>
              <TextBlock Text="GPU" Foreground="#4c4f69" FontWeight="SemiBold"/>
            </StackPanel>
          </Border>

          <!-- Console -->
          <Border Tag="Console" CornerRadius="6" Padding="10,9" Cursor="Hand"
                  Background="#d4f0f8" BorderBrush="#04a5e5" BorderThickness="1"
                  PointerPressed="OnSourceItemPressed">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Ellipse Width="8" Height="8" Fill="#04a5e5" VerticalAlignment="Center"/>
              <TextBlock Text="Console" Foreground="#4c4f69" FontWeight="SemiBold"/>
            </StackPanel>
          </Border>

        </StackPanel>
      </DockPanel>
    </Border>

    <!-- ══ RIGHT PANEL ═════════════════════════════════════════════════ -->
    <DockPanel Grid.Column="1" Margin="16">

      <!-- Table header -->
      <Border DockPanel.Dock="Top" Background="#ccd0da"
              Padding="12,8" CornerRadius="6,6,0,0">
        <Grid ColumnDefinitions="110,140,120,*,110">
          <TextBlock Grid.Column="0" Text="Type"          Foreground="#4c4f69" FontWeight="Bold"/>
          <TextBlock Grid.Column="1" Text="Start Address" Foreground="#4c4f69" FontWeight="Bold"/>
          <TextBlock Grid.Column="2" Text="Size"          Foreground="#4c4f69" FontWeight="Bold"/>
          <TextBlock Grid.Column="3" Text="File"          Foreground="#4c4f69" FontWeight="Bold"/>
          <TextBlock Grid.Column="4" Text=""              Foreground="#4c4f69" FontWeight="Bold"/>
        </Grid>
      </Border>

      <!-- Drop zone -->
      <Border x:Name="DropBorder"
              DockPanel.Dock="Top"
              Background="#e6e9ef"
              BorderBrush="#bcc0cc" BorderThickness="1"
              CornerRadius="0,0,6,6"
              MinHeight="400"
              DragDrop.AllowDrop="True"
              DragDrop.DragOver="OnTableDragOver"
              DragDrop.Drop="OnTableDrop">
        <ScrollViewer>
          <ItemsControl x:Name="TableList">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:DeviceViewModel">
                <Border BorderBrush="#ccd0da" BorderThickness="0,0,0,1"
                        Padding="6,6" Cursor="Hand"
                        PointerPressed="OnRowPressed">
                  <Grid ColumnDefinitions="110,140,120,*,110">

                    <!-- Type badge -->
                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal" Spacing="8"
                                VerticalAlignment="Center">
                      <Ellipse Width="9" Height="9"
                               Fill="{Binding BadgeColor}"
                               VerticalAlignment="Center"/>
                      <TextBlock Text="{Binding Type}"
                                 Foreground="#4c4f69"
                                 FontWeight="SemiBold"
                                 VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Start address -->
                    <TextBox Grid.Column="1"
                             Text="{Binding StartAddressText}"
                             Background="#eff1f5" Foreground="#4c4f69"
                             BorderBrush="#bcc0cc" BorderThickness="1"
                             FontFamily="Consolas,monospace"
                             Padding="6,4" Margin="0,0,8,0"
                             VerticalAlignment="Center"/>

                    <!-- Size (editable) -->
                    <TextBox Grid.Column="2"
                             IsVisible="{Binding !IsFixedSize}"
                             Text="{Binding SizeText}"
                             Background="#eff1f5" Foreground="#4c4f69"
                             BorderBrush="#bcc0cc" BorderThickness="1"
                             FontFamily="Consolas,monospace"
                             Padding="6,4" Margin="0,0,8,0"
                             VerticalAlignment="Center"/>

                    <!-- Size (fixed / read-only) -->
                    <Border Grid.Column="2"
                            IsVisible="{Binding IsFixedSize}"
                            Background="#dce0e8"
                            BorderBrush="#ccd0da" BorderThickness="1"
                            CornerRadius="4"
                            Padding="6,4" Margin="0,0,8,0"
                            VerticalAlignment="Center">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{Binding SizeText}"
                                   Foreground="#9ca0b0"
                                   FontFamily="Consolas,monospace"/>
                        <TextBlock Text="fixed"
                                   Foreground="#bcc0cc"
                                   FontSize="10"
                                   VerticalAlignment="Center"/>
                      </StackPanel>
                    </Border>

                    <!-- File (ROM / Disk only) -->
                    <StackPanel Grid.Column="3"
                                Orientation="Horizontal" Spacing="6"
                                VerticalAlignment="Center">
                      <Ellipse Width="6" Height="6"
                               Fill="{Binding BadgeColor}"
                               VerticalAlignment="Center"
                               Opacity="0.6"
                               IsVisible="{Binding HasFile}"/>
                      <TextBlock Foreground="#6c6f85"
                                 TextTrimming="CharacterEllipsis"
                                 VerticalAlignment="Center"
                                 Text="{Binding FileName}"
                                 IsVisible="{Binding HasFile}"/>
                      <TextBlock Foreground="#9ca0b0"
                                 VerticalAlignment="Center"
                                 Text="—"
                                 IsVisible="{Binding !HasFile}"/>
                    </StackPanel>

                    <!-- Actions -->
                    <StackPanel Grid.Column="4"
                                Orientation="Horizontal" Spacing="4"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                      <Button IsVisible="{Binding HasFile}"
                              Content="📂"
                              Background="#dce0e8"
                              Foreground="#4c4f69"
                              Padding="7,4"
                              Click="OnBrowseClick"
                              ToolTip.Tip="Choose file"/>
                      <Button Content="✕"
                              Background="#fbe8ea"
                              Foreground="#d20f39"
                              Padding="7,4"
                              Click="OnRemoveClick"
                              ToolTip.Tip="Remove device"/>
                    </StackPanel>

                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Border>
    </DockPanel>
  </Grid>
</Window>