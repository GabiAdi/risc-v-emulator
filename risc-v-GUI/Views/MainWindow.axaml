<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:risc_v_GUI.ViewModels"
        xmlns:local="clr-namespace:risc_v_GUI.Models"
        x:Class="risc_v_GUI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="risc_v_GUI"
        Width="1440" Height="900"
        Background="#181825">
  
  <Window.Styles>
    <Style Selector="Button">
      <Setter Property="Background"      Value="#313244"/>
      <Setter Property="Foreground"      Value="#cdd6f4"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius"    Value="5"/>
      <Setter Property="Padding"         Value="12,6"/>
      <Setter Property="FontWeight"      Value="SemiBold"/>
      <Setter Property="Cursor"          Value="Hand"/>
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#45475a"/>
    </Style>
    <Style Selector="Button:disabled /template/ ContentPresenter">
      <Setter Property="Background" Value="#1e1e2e"/>
      <Setter Property="Opacity"    Value="0.4"/>
    </Style>
    <Style Selector="Button.accent">
      <Setter Property="Background" Value="#cba6f7"/>
      <Setter Property="Foreground" Value="#1e1e2e"/>
    </Style>
    <Style Selector="Button.accent:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#b4befe"/>
    </Style>
    <Style Selector="Button.danger">
      <Setter Property="Background" Value="#f38ba8"/>
      <Setter Property="Foreground" Value="#1e1e2e"/>
    </Style>
    <Style Selector="Button.danger:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#eba0ac"/>
    </Style>
    <Style Selector="DataGrid">
      <Setter Property="Background"               Value="#1e1e2e"/>
      <Setter Property="Foreground"               Value="#cdd6f4"/>
      <Setter Property="BorderBrush"              Value="#313244"/>
      <Setter Property="BorderThickness"          Value="1"/>
      <Setter Property="RowBackground"            Value="#1e1e2e"/>
      <Setter Property="HorizontalGridLinesBrush" Value="#313244"/>
      <Setter Property="VerticalGridLinesBrush"   Value="#313244"/>
      <Setter Property="FontFamily"               Value="DejaVu Sans Mono,Consolas,Courier New,monospace"/>
    </Style>
    <Style Selector="DataGridColumnHeader">
      <Setter Property="Background"  Value="#313244"/>
      <Setter Property="Foreground"  Value="#cdd6f4"/>
      <Setter Property="FontWeight"  Value="Bold"/>
      <Setter Property="Padding"     Value="10,8"/>
      <Setter Property="BorderBrush" Value="#45475a"/>
    </Style>
    <Style Selector="DataGridCell">
      <Setter Property="Padding" Value="10,0"/>
    </Style>
    <Style Selector="Menu">
      <Setter Property="Background" Value="#12121e"/>
      <Setter Property="Foreground" Value="#cdd6f4"/>
    </Style>
    <Style Selector="MenuItem">
      <Setter Property="Foreground" Value="#cdd6f4"/>
    </Style>
    <Style Selector="MenuItem:pointerover /template/ Border#Root">
      <Setter Property="Background" Value="#313244"/>
    </Style>
  </Window.Styles>

  <DockPanel LastChildFill="True">

    <!-- ── Menu bar ─────────────────────────────────────────────────── -->
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_File">
        <MenuItem Header="_Open"  Command="{Binding open_program}" CommandParameter="{Binding $parent[Window]}"/>
        <MenuItem Header="_Exit"/>
      </MenuItem>
      <MenuItem Header="_Tools">
        <MenuItem Header="_Memory view"    Command="{Binding open_memory_view}"/>
        <MenuItem Header="_Assembler"      Command="{Binding open_assembler_view}"/>
        <MenuItem Header="_Symbol view"    Command="{Binding open_symbol_view}"/>
        <MenuItem Header="Screen _view"    Command="{Binding open_screen_view}"/>
        <MenuItem Header="_Device manager" Command="{Binding open_device_view}"/>
      </MenuItem>
      <MenuItem Header="_CPU Settings">
        <MenuItem Header="_Halt on ebreak" Command="{Binding toggle_halt_on_ebreak}">
          <MenuItem.Icon>
            <CheckBox IsChecked="{Binding halt_on_ebreak}" Margin="0"/>
          </MenuItem.Icon>
        </MenuItem>
      </MenuItem>
    </Menu>

    <LayoutTransformControl>
      <LayoutTransformControl.LayoutTransform>
        <ScaleTransform ScaleX="1" ScaleY="1"/>
      </LayoutTransformControl.LayoutTransform>

      <DockPanel Margin="20" LastChildFill="True">

        <!-- ── Control toolbar ────────────────────────────────────────── -->
        <Border DockPanel.Dock="Top"
                Background="#1e1e2e"
                BorderBrush="#313244" BorderThickness="1"
                CornerRadius="6" Padding="10,8" Margin="0,0,0,12">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="EXECUTION" Foreground="#6c7086"
                       FontSize="11" FontWeight="Bold" LetterSpacing="2"
                       VerticalAlignment="Center" Margin="0,0,12,0"/>
            <Button Content="⏵  Step"              Click="step"             Name="bt_step"/>
            <Button Content="⏵⏵ Run to Break"      Click="run_until_break"  Name="bt_run"   Classes="accent"/>
            <Button Content="⚡ Interrupt"          Click="interrupt"        Name="bt_int"/>
            <Button Content="✕  Clear Interrupt"   Click="clear_interrupt"  Name="bt_clr"/>
            <Button Content="⏸  Halt"              Click="halt"             Name="bt_halt"  Classes="danger"/>
            <Button Content="⏵  Unhalt"            Click="unhalt"           Name="bt_unhalt" IsEnabled="False"/>
          </StackPanel>
        </Border>

        <!-- ── Status bar ─────────────────────────────────────────────── -->
        <Border DockPanel.Dock="Bottom"
                Background="#12121e"
                BorderBrush="#313244" BorderThickness="1"
                CornerRadius="6" Padding="4" Margin="0,12,0,0"
                Height="100">
          <ListBox Background="Transparent"
                   ItemsSource="{Binding Status}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}"
                           Foreground="#a6adc8"
                           FontFamily="Consolas,monospace"
                           FontSize="12"/>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Border>

        <!-- ── Main content ───────────────────────────────────────────── -->
        <Grid RowDefinitions="*,300" ColumnDefinitions="800,*">

          <!-- Console output -->
          <Border Grid.Row="0" Grid.Column="0"
                  BorderBrush="#313244" BorderThickness="1"
                  CornerRadius="6" Margin="0,0,8,8"
                  ClipToBounds="True"
                  Background="#12121e">
            <Panel>

              <ScrollViewer x:Name="ConsoleScroller"
                            HorizontalScrollBarVisibility="Auto"
                            VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding ConsoleLines}" Padding="8">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:ConsoleLine">
                      <TextBlock Text="{Binding Text}"
                                 Foreground="{Binding Color}"
                                 FontFamily="Liberation Mono,DejaVu Sans Mono,Consolas,Courier New"
                                 FontSize="13"
                                 TextWrapping="NoWrap"/>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>

              <!-- Transparent focusable overlay on top -->
              <Border x:Name="ConsoleInput"
                      Background="Transparent"
                      Focusable="True"
                      KeyDown="on_key_down"
                      PointerPressed="OnConsoleClicked">
                <Border.Styles>
                  <Style Selector="Border:focus">
                    <Setter Property="BorderBrush" Value="#cba6f7"/>
                    <Setter Property="BorderThickness" Value="1"/>
                  </Style>
                </Border.Styles>
              </Border>

            </Panel>
          </Border>

          <!-- Registers -->
          <Border Grid.Row="0" Grid.Column="1"
                  BorderBrush="#313244" BorderThickness="1"
                  CornerRadius="6" Margin="0,0,0,8"
                  ClipToBounds="True">
            <DataGrid ItemsSource="{Binding Registers}"
                      IsReadOnly="True"
                      AutoGenerateColumns="False"
                      GridLinesVisibility="Horizontal"
                      RowHeight="23"
                      CanUserResizeColumns="True">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Reg"   Binding="{Binding Register}" Width="80"/>
                <DataGridTextColumn Header="Name"  Binding="{Binding Name}"     Width="100"/>
                <DataGridTextColumn Header="Value" Binding="{Binding Value}"    Width="*"/>
              </DataGrid.Columns>
            </DataGrid>
          </Border>

          <!-- Memory / disassembly -->
          <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                  BorderBrush="#313244" BorderThickness="1"
                  CornerRadius="6"
                  ClipToBounds="True">
            <DataGrid ItemsSource="{Binding Memory}"
                      IsReadOnly="True"
                      AutoGenerateColumns="False"
                      GridLinesVisibility="Horizontal"
                      RowHeight="23"
                      CanUserResizeColumns="True">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Address"     Binding="{Binding Address}"     Width="130"/>
                <DataGridTextColumn Header="Register"    Binding="{Binding Register}"    Width="100"/>
                <DataGridTextColumn Header="Value"       Binding="{Binding Value}"       Width="220"/>
                <DataGridTextColumn Header="Disassembly" Binding="{Binding Disassembly}" Width="*"/>
                <DataGridTextColumn Header="ASCII"       Binding="{Binding Ascii}"       Width="100"/>
              </DataGrid.Columns>
            </DataGrid>
          </Border>

        </Grid>
      </DockPanel>
    </LayoutTransformControl>
  </DockPanel>
</Window>