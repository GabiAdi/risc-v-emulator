<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:risc_v_GUI.ViewModels"
        x:Class="risc_v_GUI.MemoryView"
        x:DataType="vm:MainWindowViewModel"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        Title="Memory View"
        Width="900" Height="540"
        Background="#181825">

  <Window.Styles>

    <!-- TextBox -->
    <Style Selector="TextBox">
      <Setter Property="Background"       Value="#1e1e2e"/>
      <Setter Property="Foreground"       Value="#cdd6f4"/>
      <Setter Property="BorderBrush"      Value="#45475a"/>
      <Setter Property="BorderThickness"  Value="1"/>
      <Setter Property="CornerRadius"     Value="5"/>
      <Setter Property="Padding"          Value="8,5"/>
      <Setter Property="FontFamily"       Value="Consolas,monospace"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBox:focus">
      <Setter Property="BorderBrush" Value="#cba6f7"/>
    </Style>

    <!-- Button -->
    <Style Selector="Button">
      <Setter Property="Background"      Value="#313244"/>
      <Setter Property="Foreground"      Value="#cdd6f4"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius"    Value="5"/>
      <Setter Property="Padding"         Value="12,6"/>
      <Setter Property="FontWeight"      Value="SemiBold"/>
      <Setter Property="Cursor"          Value="Hand"/>
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#45475a"/>
    </Style>
    <Style Selector="Button.accent">
      <Setter Property="Background" Value="#cba6f7"/>
      <Setter Property="Foreground" Value="#1e1e2e"/>
    </Style>
    <Style Selector="Button.accent:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#b4befe"/>
    </Style>

    <!-- ComboBox -->
    <Style Selector="ComboBox">
      <Setter Property="Background"      Value="#1e1e2e"/>
      <Setter Property="Foreground"      Value="#cdd6f4"/>
      <Setter Property="BorderBrush"     Value="#45475a"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius"    Value="5"/>
      <Setter Property="Padding"         Value="8,5"/>
    </Style>

    <!-- DataGrid -->
    <Style Selector="DataGrid">
      <Setter Property="Background"              Value="#1e1e2e"/>
      <Setter Property="Foreground"              Value="#cdd6f4"/>
      <Setter Property="BorderBrush"             Value="#313244"/>
      <Setter Property="BorderThickness"         Value="1"/>
      <Setter Property="RowBackground"           Value="#1e1e2e"/>
      <Setter Property="HorizontalGridLinesBrush" Value="#313244"/>
      <Setter Property="VerticalGridLinesBrush"   Value="#313244"/>
      <Setter Property="FontFamily"               Value="Consolas,monospace"/>
    </Style>
    <Style Selector="DataGridColumnHeader">
      <Setter Property="Background"  Value="#313244"/>
      <Setter Property="Foreground"  Value="#cdd6f4"/>
      <Setter Property="FontWeight"  Value="Bold"/>
      <Setter Property="Padding"     Value="10,8"/>
      <Setter Property="BorderBrush" Value="#45475a"/>
    </Style>
    <Style Selector="DataGridRow:selected /template/ Rectangle#BackgroundRectangle">
      <Setter Property="Fill" Value="#313244"/>
    </Style>
    <Style Selector="DataGridCell">
      <Setter Property="Padding" Value="10,0"/>
    </Style>

  </Window.Styles>

  <DockPanel Margin="20" LastChildFill="True">

    <!-- ── Top label ──────────────────────────────────────────────────── -->
    <TextBlock DockPanel.Dock="Top"
               Text="MEMORY VIEW"
               Foreground="#6c7086"
               FontSize="11" FontWeight="Bold"
               LetterSpacing="2"
               Margin="0,0,0,14"/>

    <!-- ── Toolbar row 1: Refresh / entries / address / goto ──────────── -->
    <Border DockPanel.Dock="Top"
            Background="#1e1e2e"
            BorderBrush="#313244" BorderThickness="1"
            CornerRadius="6"
            Padding="10,8"
            Margin="0,0,0,8">
      <StackPanel Orientation="Horizontal" Spacing="8">

        <Button Content="↺  Refresh"
                Classes="accent"
                Name="bt_refresh"
                Click="refresh"/>

        <Separator Width="1" Background="#45475a" Margin="4,0"/>

        <TextBlock Text="Show" Foreground="#6c7086"
                   VerticalAlignment="Center"/>
        <TextBox Name="tb_entry" Width="70" Text="32"/>
        <TextBlock Text="bytes" Foreground="#6c7086"
                   VerticalAlignment="Center"/>

        <Separator Width="1" Background="#45475a" Margin="4,0"/>

        <TextBlock Text="Go to" Foreground="#6c7086"
                   VerticalAlignment="Center"/>
        <TextBox Name="tb_address" Width="110"
                 Text="0x00000000"/>
        <Button Content="→  Jump"
                Name="bt_goto"
                Click="goto_addr"/>

      </StackPanel>
    </Border>

    <!-- ── Toolbar row 2: Search ──────────────────────────────────────── -->
    <Border DockPanel.Dock="Top"
            Background="#1e1e2e"
            BorderBrush="#313244" BorderThickness="1"
            CornerRadius="6"
            Padding="10,8"
            Margin="0,0,0,12">
      <StackPanel Orientation="Horizontal" Spacing="8">

        <TextBlock Text="Search" Foreground="#6c7086"
                   VerticalAlignment="Center"/>
        <TextBox Name="tb_search" Width="220"/>
        <ComboBox Name="cb_search" Width="160"
                  ItemsSource="{Binding Search}"
                  SelectedItem="{Binding SelectedSearch}"/>
        <Button Content="🔍  Search"
                Name="bt_search"
                Click="search"/>

      </StackPanel>
    </Border>

    <!-- ── Data grid ──────────────────────────────────────────────────── -->
    <Border DockPanel.Dock="Top"
            BorderBrush="#313244" BorderThickness="1"
            CornerRadius="6"
            ClipToBounds="True">
      <DataGrid ItemsSource="{Binding MemoryView}"
                IsReadOnly="True"
                AutoGenerateColumns="False"
                GridLinesVisibility="Horizontal"
                RowHeight="24"
                CanUserResizeColumns="True"
                CanUserSortColumns="True">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Address"     Binding="{Binding Address}"     Width="130"/>
          <DataGridTextColumn Header="Register"    Binding="{Binding Register}"    Width="100"/>
          <DataGridTextColumn Header="Value"       Binding="{Binding Value}"       Width="220"/>
          <DataGridTextColumn Header="Disassembly" Binding="{Binding Disassembly}" Width="*"/>
          <DataGridTextColumn Header="ASCII"       Binding="{Binding Ascii}"       Width="100"/>
        </DataGrid.Columns>
      </DataGrid>
    </Border>

  </DockPanel>
</Window>